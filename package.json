{
  "name": "manilla",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Envelope budgeting with a virtual-envelope ledger",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p ${MANILLA_PORT:-3001}",
    "dev:cert": "bash scripts/dev-cert.sh",
    "dev:https": "next dev -p ${MANILLA_PORT:-3001} --experimental-https --experimental-https-key ./certs/dev-key.pem --experimental-https-cert ./certs/dev-cert.pem",
    "build": "next build",
    "start": "next start",
    "test": "node --env-file-if-exists=.env --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "drizzle-kit studio",
    "ofx": "node spikes/parse-ofx.ts",
    "goodbudget": "node spikes/inspect-goodbudget.ts",
    "categorize": "node --env-file-if-exists=.env spikes/categorize-eval.ts",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "icons": "node scripts/icons.mjs",
    "import": "node --env-file-if-exists=.env scripts/import.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.5",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
