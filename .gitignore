node_modules/
dist/
.next/
next-env.d.ts
*.tsbuildinfo
.env
.env.local

# Real financial exports never get committed.
data/private/*
!data/private/.gitkeep

# Database backups. They hold the whole ledger, so they stay on the machine.
backups/

# Development certificates for reaching the app from a phone over the LAN. The CA
# key can mint a certificate for any name a device trusting it visits, so it
# never leaves this machine.
certs/

# Spike output
out/

# Your deployment, as opposed to the one in docker-compose.yml. Compose reads
# this automatically and merges it over the base file, so anything that does not
# fit an environment variable - an extra volume, a different image tag, a port
# you do want published - goes here instead of into a tracked file.
docker-compose.override.yml
