# Copy this file to .env and fill in your key. .env is gitignored.
#
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com -> Settings -> API keys.
# The key is shown once, so paste it straight in. Anyone holding it can spend
# against your account, so it never goes in a commit, a screenshot or a chat.

ANTHROPIC_API_KEY=sk-ant-...

# Plaid, for automatic bank feeds (FR-15 to FR-20, #10). Optional: without these
# everything else works and statements come in as files. Each install uses its
# own keys - sign up at https://dashboard.plaid.com and copy them from
# Developers -> Keys. The sandbox secret only reaches fake banks; the production
# one reaches real accounts, so treat it like ANTHROPIC_API_KEY above.
# `npm run plaid` runs only against the sandbox.
#PLAID_CLIENT_ID=
#PLAID_SECRET=
#PLAID_ENV=sandbox
#
# The key a bank connection's access token is encrypted with (FR-20), kept
# here rather than in the database so a backup alone holds nothing that reaches
# the bank. Required once a bank is linked; generate it once with
#   openssl rand -base64 32
# and keep it with your backups' other secrets. Lose or change it and every
# connection has to be linked again - the tokens cannot be read without it.
#MANILLA_SECRET_KEY=

# The Postgres password. Required: `docker compose up` refuses to start without
# it, because a default that works is a default nobody changes, and this one
# guards the database holding your money (#15). Set it before the first
# `docker compose up`, and use the same value in DATABASE_URL below.
#   generate one with:  openssl rand -base64 24 | tr -d '/+='
# (no / + or =, since it also goes into a URL unescaped)
#
# Postgres reads this only when it first creates its volume. Changing it later
# does not change the database's password - it just stops the app connecting.
# An install from before this was required runs with `manilla`. To change it on
# an install that is already running, in this order:
#   1. set the new value here, and in DATABASE_URL if this machine runs npm scripts
#   2. docker compose exec db psql -U manilla -c "ALTER USER manilla PASSWORD 'new'"
#   3. docker compose up -d
# Here first, because every `docker compose` command - exec included - refuses
# to run while this is blank. The running containers keep their old settings
# until step 3, and psql inside the db container needs no password.
# A development volume made before then can simply say POSTGRES_PASSWORD=manilla.
POSTGRES_PASSWORD=

# Local development points at the Postgres from `docker compose up -d db`,
# which is published on 5433 to avoid clashing with an existing 5432.
# The password here is POSTGRES_PASSWORD's.
DATABASE_URL=postgres://manilla:<POSTGRES_PASSWORD>@localhost:5433/manilla

# The port `npm run dev` serves on. 3001 rather than 3000 because this machine
# already runs something on 3000; change it if that is not true for you. Note
# that npm reads this from the shell, not from here, since it expands the value
# before Next loads this file: `MANILLA_PORT=3005 npm run dev`.
#
# In production the app publishes no port at all - it lives inside its Tailscale
# node's network namespace and is reachable only through it.
MANILLA_PORT=3001

# The timezone your calendar days are in, as an IANA name. Dates in Manilla are
# calendar days, and "today" - which month the home screen shows, the day a
# funding or an opening balance is dated - is the server's. A container's own
# zone is UTC, which puts every evening in the Americas into tomorrow; the app
# logs a warning at start while this is unset.
#MANILLA_TIMEZONE=America/Toronto

# --- The home server -------------------------------------------------------
#
# Manilla runs as its own node on your tailnet, so it gets its own hostname and
# its own certificate without going through a reverse proxy, and anything else on
# the machine is untouched. The name below is the node's name: the app ends up at
# https://<that>.<your-tailnet>.ts.net.
#MANILLA_TS_HOSTNAME=manilla

# Only needed the first time the sidecar starts: it authenticates once and keeps
# its identity in a Docker volume afterwards. Make a reusable key at
# https://login.tailscale.com/admin/settings/keys - it signs a device into your
# tailnet, so treat it like a password and clear it once the node is up.
#TS_AUTHKEY=tskey-auth-...

# Who can reach it. The default serves it to your tailnet only. Setting this to
# tailscale-serve-funnel.json also puts it on the public internet through
# Tailscale Funnel, at the same address - so passkeys keep working and nobody
# needs Tailscale to sign in. It also needs the `funnel` attribute for this node
# in your tailnet policy; see "Reaching it without Tailscale" in the README.
#MANILLA_SERVE_CONFIG=tailscale-serve-funnel.json

# Registering the first passkey claims the whole install, so in production only a
# signed-in tailnet user can do it, and never over Funnel. Behind Nginx, or from
# a tagged device, there is no Tailscale identity to check; set this to 1 until
# the first passkey exists, then remove it.
#MANILLA_ALLOW_SETUP=1

# Sign-in activity - a passkey added, a recovery code used or guessed at, someone
# invited, joining or removed - is shown in the app to everyone who did not do
# it. Set this to also have each line POSTed as plain text as it happens, which
# is what ntfy (https://ntfy.sh, or your own) turns into a phone notification.
# The text names people and nothing else. On the public ntfy.sh anyone who knows
# the topic can read it, so make the topic long and random, or run your own.
#MANILLA_ALERT_URL=https://ntfy.sh/manilla-<something long and random>

# The nightly bank sync, the same way: one notification when it brought in
# transactions to review, or when a bank wants you to sign in again (that one
# marked urgent), and nothing on a night with nothing new. Bank names and
# counts, never amounts or payees. Use a different topic from MANILLA_ALERT_URL,
# so a daily "5 to review" never trains you to swipe past a sign-in alert, and
# so each person can follow one without the other.
#MANILLA_SYNC_NOTIFY_URL=https://ntfy.sh/manilla-<another long random name>

# Anything that is not a single value - an extra volume, a different image tag, a
# port you want published - goes in a `docker-compose.override.yml` instead.
# Compose merges it over docker-compose.yml automatically, and it is gitignored,
# so your arrangement never has to be an edit to a tracked file.

# Hostnames, besides localhost, that may load dev assets from `next dev` - set
# this to the machine's LAN address if you want to open the dev server from
# another device on the network. Comma-separated. Development only.
#MANILLA_DEV_ORIGINS=192.168.1.2

# Passkeys are bound to an exact hostname and origin (NF-3), port included - a
# mismatch means every sign-in fails, so MANILLA_ORIGIN has to name the port the
# app is actually served on. Locally the values below are right; on the server set
# them to the Tailscale name you actually type, e.g.
#   MANILLA_RP_ID=manilla.your-tailnet.ts.net
#   MANILLA_ORIGIN=https://manilla.your-tailnet.ts.net
MANILLA_RP_ID=localhost
MANILLA_ORIGIN=http://localhost:3001

# What `npm run seed` calls the account it creates. Cosmetic; rename it in the
# app afterwards if you like.
#
# There is deliberately no setting here for the account *number*. The first
# statement you import will not match anything, so the import screen asks which
# account it belongs to, and remembers the answer - after which every later
# statement finds its account on its own (FR-7). That is one dropdown, once,
# instead of a real financial identifier sitting in a file.
SEED_ACCOUNT_NAME=Main Chequing
